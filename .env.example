# Nexus IA - variaveis de ambiente

# Admin (obrigatorio para Edge Functions / painel)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Supabase self-hosted (appsbrasil.store)
SUPABASE_URL=https://supabase.appsbrasil.store
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DOWNLOADS_TABLE=downloads
SUPABASE_CONTACT_REQUESTS_TABLE=contact_requests
SUPABASE_USERS_TABLE=users

# Deploy Storage (bucket publico do site)
SUPABASE_SITE_BUCKET=fluxoia-site
SUPABASE_KONG_USER=""
SUPABASE_KONG_PASSWORD=""

# Deploy Edge Functions via SSH (self-hosted — API de deploy e read-only)
SUPABASE_SSH_HOST=""
SUPABASE_SSH_USER=root
SUPABASE_SSH_KEY=""
SUPABASE_SSH_PORT=22
SUPABASE_FUNCTIONS_PATH=/opt/supabase/docker/volumes/functions
SUPABASE_SSH_COMPOSE_DIR=/opt/supabase/docker
SUPABASE_FUNCTIONS_RESTART_CMD="cd /opt/supabase/docker && docker compose restart functions --no-deps"

# Alternativas de persistencia (opcional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
